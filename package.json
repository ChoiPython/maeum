{
  "name": "maeum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14.0 <23" },
  "workspaces": ["apps/client", "apps/server"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "npm run dev --workspace @maeum/client",
    "dev:server": "npm run dev --workspace @maeum/server",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "tsx --test apps/server/test/garden.test.ts",
    "check:docs": "node 개발준비/준비자료검증.mjs",
    "check": "npm run check:docs && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
